---
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { formatPostDate, postSlug } from '../../lib/posts';
import { slugifyTag } from '../../lib/tags';

export async function getStaticPaths() {
  const posts = (await getCollection('blog'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return posts
    .map((post, index) => {
      const previousPost = posts[index + 1];
      const nextPost = posts[index - 1];
      const slug = postSlug(post);
      return {
        params: { slug },
        props: { post, slug, previousPost, nextPost },
      };
    });
}

const { post, slug, previousPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const sectionHeadings = headings.filter((heading) => heading.depth === 2);
// Tags whose slug is empty have no archive page; skip their chips.
const tags = post.data.tags.filter((tag) => slugifyTag(tag) !== '');

const postSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  url: new URL(`/blog/${slug}/`, Astro.site).toString(),
  author: {
    '@type': 'Person',
    name: 'Your Name',
    url: 'https://example.com/about/',
  },
  // Escape < so a post title/description can never close the <script> tag.
}).replace(/</g, '\\u003c');
---

<Layout
  title={`${post.data.title} — Your Name`}
  description={post.data.description}
  canonicalPath={`/blog/${slug}/`}
  ogType="article"
>
  <script type="application/ld+json" is:inline set:html={postSchema} />
  <main class="content-shell">
    <div class="article-layout section" style="max-width: var(--max); padding-inline: 1.25rem;">
      <aside class="article-toc" aria-label="Article sections">
        {sectionHeadings.length > 0 && (
          <nav>
            {sectionHeadings.map((heading) => (
              <a href={`#${heading.slug}`} data-heading-link={heading.slug}>{heading.text}</a>
            ))}
          </nav>
        )}
      </aside>

      <article class="article-shell" data-pagefind-body>
        <header class="article-header">
          <p class="post-meta">
            <time datetime={post.data.date.toISOString()}>
              {formatPostDate(post.data.date)}
            </time>
            {/* data-pagefind-ignore keeps tag labels out of the search index. */}
            {tags.map((tag) => (
              <a href={`/tags/${slugifyTag(tag)}/`} data-pagefind-ignore>#{tag}</a>
            ))}
          </p>
          <h1>{post.data.title}</h1>
          <p>{post.data.description}</p>
        </header>
        <div class="article-prose">
          <Content />
        </div>
        <nav class="article-nav" aria-label="Post navigation">
          {previousPost ? (
            <a class="article-nav-link article-nav-previous" href={`/blog/${postSlug(previousPost)}/`}>
              <span class="article-nav-label">Previous</span>
              <strong>{previousPost.data.title}</strong>
            </a>
          ) : <span />}
          {nextPost ? (
            <a class="article-nav-link article-nav-next" href={`/blog/${postSlug(nextPost)}/`}>
              <span class="article-nav-label">Next</span>
              <strong>{nextPost.data.title}</strong>
            </a>
          ) : <span />}
        </nav>
        <button class="article-like" type="button" data-like-id={post.data.id} aria-pressed="false" aria-label="Like this post">
          <svg viewBox="0 0 26 26" aria-hidden="true">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z" />
          </svg>
          <span class="article-like-count" data-like-count>Like</span>
        </button>
        <section class="article-comments" aria-label="Comments">
          <div id="remark42">Comments loading...</div>
        </section>
      </article>
    </div>
  </main>

  <script>
    const REMARK_HOST = import.meta.env.PUBLIC_REMARK_HOST;

    type Remark42 = {
      createInstance: (config: Record<string, unknown>) => { destroy: () => void };
      changeTheme: (theme: 'light' | 'dark') => void;
    };
    const w = window as typeof window & {
      remark_config?: Record<string, unknown>;
      REMARK42?: Remark42;
    };

    let tocObserver: IntersectionObserver | undefined;
    let commentsInstance: { destroy: () => void } | undefined;
    let embedRequested = false;

    function initToc() {
      tocObserver?.disconnect();
      const headings = Array.from(document.querySelectorAll('.article-prose h2[id]'));
      const links = new Map(
        Array.from(document.querySelectorAll('[data-heading-link]')).map((link) => [
          link.getAttribute('data-heading-link'),
          link,
        ]),
      );
      if (headings.length === 0 || links.size === 0) return;

      function setActive(id: string) {
        for (const link of links.values()) link.removeAttribute('aria-current');
        links.get(id)?.setAttribute('aria-current', 'true');
      }

      setActive(headings[0].id);
      tocObserver = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (visible?.target instanceof HTMLElement) setActive(visible.target.id);
        },
        { rootMargin: '-18% 0px -68% 0px', threshold: 0 },
      );
      for (const heading of headings) tocObserver.observe(heading);
    }

    // Map the active palette to Remark42's light/dark themes by the
    // luminance of --bg, so all palettes work without a hard-coded list.
    function paletteTheme(): 'light' | 'dark' {
      const bg = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim();
      const hex = bg.replace('#', '');
      const full = hex.length === 3 ? [...hex].map((c) => c + c).join('') : hex;
      const luma =
        0.2126 * parseInt(full.slice(0, 2), 16) +
        0.7152 * parseInt(full.slice(2, 4), 16) +
        0.0722 * parseInt(full.slice(4, 6), 16);
      return luma > 128 ? 'light' : 'dark';
    }

    function initComments() {
      const node = document.getElementById('remark42');
      if (!node) {
        try {
          commentsInstance?.destroy();
        } catch {}
        commentsInstance = undefined;
        return;
      }

      w.remark_config = {
        host: REMARK_HOST,
        site_id: 'databee',
        url: window.location.origin + window.location.pathname,
        theme: paletteTheme(),
        show_email_subscription: false,
      };

      if (w.REMARK42) {
        try {
          commentsInstance?.destroy();
        } catch {}
        commentsInstance = w.REMARK42.createInstance(w.remark_config);
      } else if (!embedRequested) {
        // embed.mjs self-initializes against #remark42 using remark_config.
        embedRequested = true;
        const script = document.createElement('script');
        script.src = `${REMARK_HOST}/web/embed.mjs`;
        script.type = 'module';
        document.head.append(script);
      }
    }

    // <html> survives view transitions, so one observer follows palette
    // switches for the life of the session.
    new MutationObserver(() => {
      w.REMARK42?.changeTheme(paletteTheme());
    }).observe(document.documentElement, { attributeFilter: ['data-palette'] });

    function init() {
      initToc();
      initComments();
      initLike();
      initCodeBlocks();
    }

    function initCodeBlocks() {
      document.querySelectorAll<HTMLPreElement>('.article-prose pre').forEach((pre) => {
        if (pre.dataset.enhanced === 'true') return;
        const code = pre.querySelector('code');
        if (!code) return;

        const language = pre.dataset.language || code.className.match(/language-([\w-]+)/)?.[1] || 'text';
        const topbar = document.createElement('div');
        topbar.className = 'code-block-topbar';
        topbar.setAttribute('data-pagefind-ignore', '');

        const languageLabel = document.createElement('span');
        languageLabel.className = 'code-block-language';
        languageLabel.textContent = language;

        const copyButton = document.createElement('button');
        copyButton.className = 'code-block-copy';
        copyButton.type = 'button';
        copyButton.setAttribute('aria-label', 'Copy code');
        copyButton.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg><span>Copy</span>';
        copyButton.addEventListener('click', async () => {
          await navigator.clipboard.writeText(code.textContent ?? '');
          copyButton.classList.add('is-copied');
          copyButton.setAttribute('aria-label', 'Code copied');
          const label = copyButton.querySelector('span');
          if (label) label.textContent = 'Copied';
          window.setTimeout(() => {
            copyButton.classList.remove('is-copied');
            copyButton.setAttribute('aria-label', 'Copy code');
            if (label) label.textContent = 'Copy';
          }, 1400);
        });

        const actions = document.createElement('div');
        actions.className = 'code-block-actions';

        const collapseButton = document.createElement('button');
        collapseButton.className = 'code-block-collapse';
        collapseButton.type = 'button';
        pre.classList.add('is-collapsed');
        collapseButton.setAttribute('aria-expanded', 'false');
        collapseButton.setAttribute('aria-label', 'Expand code');
        collapseButton.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg><span>Expand</span>';
        collapseButton.addEventListener('click', () => {
          const collapsed = pre.classList.toggle('is-collapsed');
          collapseButton.setAttribute('aria-expanded', String(!collapsed));
          collapseButton.setAttribute('aria-label', collapsed ? 'Expand code' : 'Collapse code');
          const label = collapseButton.querySelector('span');
          if (label) label.textContent = collapsed ? 'Expand' : 'Collapse';
        });

        const expandHint = document.createElement('button');
        expandHint.className = 'code-block-expand-hint';
        expandHint.type = 'button';
        expandHint.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg><span class="visually-hidden">Click to expand</span>';
        expandHint.setAttribute('aria-label', 'Expand code');
        expandHint.addEventListener('click', () => collapseButton.click());

        actions.append(copyButton, collapseButton);
        topbar.append(languageLabel, actions);
        pre.prepend(topbar);
        pre.append(expandHint);
        if (code.scrollHeight > code.clientHeight) {
          pre.classList.add('is-collapsible');
        } else {
          pre.classList.remove('is-collapsed');
          collapseButton.setAttribute('aria-expanded', 'true');
          collapseButton.setAttribute('aria-label', 'Collapse code');
        }
        pre.dataset.enhanced = 'true';
      });
    }

    function initLike() {
      const button = document.querySelector<HTMLButtonElement>('[data-like-id]');
      const countEl = button?.querySelector<HTMLSpanElement>('[data-like-count]');
      const postId = button?.dataset.likeId;
      const apiBase = window.location.origin;
      if (!button || !countEl || !postId || !apiBase) return;

      const likedKey = `liked-post:${postId}`;
      let liked = localStorage.getItem(likedKey) === '1';
      let pending = false;

      // 0 shows the "Like" label; 1,000-9,999 use comma grouping; 10,000+ caps at "10k+".
      function formatCount(count: number): string {
        if (count <= 0) return 'Like';
        if (count < 10000) return count.toLocaleString('en-US');
        return '10k+';
      }

      function render(count: number) {
        countEl!.textContent = formatCount(count);
        button!.setAttribute('aria-pressed', String(liked));
        button!.classList.toggle('is-liked', liked);
      }

      fetch(`${apiBase}/api/posts/${encodeURIComponent(postId)}/likes`)
        .then((res) => (res.ok ? res.json() : null))
        .then((data: { likes?: number } | null) => {
          if (typeof data?.likes === 'number') render(data.likes);
        })
        .catch(() => {});

      button.onclick = async () => {
        if (pending) return;
        pending = true;
        button.disabled = true;
        const action = liked ? 'unlike' : 'like';
        try {
          const res = await fetch(`${apiBase}/api/posts/${encodeURIComponent(postId)}/${action}`, { method: 'POST' });
          if (res.ok) {
            const data: { likes: number } = await res.json();
            liked = !liked;
            if (liked) localStorage.setItem(likedKey, '1');
            else localStorage.removeItem(likedKey);
            render(data.likes);
          }
        } catch {
          // Network error or rate limit: leave the count and liked state untouched.
        } finally {
          pending = false;
          button.disabled = false;
        }
      };
    }

    init();
    // Module scripts run once per session; re-init after view-transition
    // navigations (e.g. post → post through the archive tree).
    document.addEventListener('astro:page-load', init);
  </script>
</Layout>
