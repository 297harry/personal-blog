---
import Layout from '../components/Layout.astro';
import FriendGrid from '../components/FriendGrid.astro';
import Remark42 from '../components/Remark42.astro';

const friendCircleApiUrl = import.meta.env.PUBLIC_FRIEND_CIRCLE_API_URL;
const friendCircleAssetBaseUrl = friendCircleApiUrl?.replace(/\/$/, '');
---

<Layout
    title="Links — Your Name"
    description="A collection of my favorite sites and blogs."
    canonicalPath="/links/"
>
    <main class="content-shell" data-pagefind-body>
        <div class="page-hero">
            <h1>Links</h1>
            <p class="hero-lede">A collection of my favorite sites and blogs.</p>
        </div>

        <section class="section" aria-label="Friends">
            <FriendGrid />
        </section>

        <section class="section" aria-label="Friend links">
            <div id="friend-circle-lite-root"></div>
        </section>

        <div class="section">
            <Remark42 />
        </div>
    </main>

    <script define:vars={{ friendCircleApiUrl }}>
        window.UserConfig = window.UserConfig || {
            private_api_url: friendCircleApiUrl,
            page_turning_number: 20,
            error_img: 'https://i.p-i.vip/30/20240815-66bced9226a36.webp',
        };
    </script>
    <link rel="stylesheet" href={`${friendCircleAssetBaseUrl}/main/fclite.css`} />
    <script src = "https://fclite-databee.aretexoxo.com/main/fclite.js"></script>
</Layout>